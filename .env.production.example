# ==============================================================================
# AURACRAFT-STUDIO: PRODUCTION ENVIRONMENT EXAMPLE (.env.production.example)
# Target Deployment: Cloudflare Edge Workers / Render Web Service
# ==============================================================================

# Core Backend Service
APP_ENV=production
PORT=8010
STUDIO_NAME=AuraCraft Studio
SERVICE_URL=https://auracraft-backend.onrender.com
FRONTEND_BASE_URL=https://auracraft-studio.netlify.app
CORS_ORIGINS=https://auracraft-studio.netlify.app
API_ADMIN_KEY=replace_with_a_long_random_secret

# Telegram Bot & Topic 215 Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1003992125718
TELEGRAM_TOPIC_ID=215
TELEGRAM_ENABLED=true
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_ALLOWED_USER_IDS=1686310706,6759217947

# Cloudflare Edge Worker Configuration
BACKEND_API_URL=https://auracraft-backend.onrender.com
CLOUDFLARE_WORKER_NAME=auracraft-studio-telegram-worker
CLOUDFLARE_WORKER_ROUTE=https://auracraft-studio-telegram-worker.<workers-subdomain>.workers.dev
